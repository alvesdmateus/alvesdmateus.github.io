---
import SelectorLayout from '@layouts/SelectorLayout.astro';
import SpecialtyArtwork from '@components/ui/SpecialtyArtwork.astro';
import { getCollection } from 'astro:content';
import siteData from '@data/site.json';

const socialLinks = await getCollection('social');
---

<SelectorLayout
  title="Mateus Alves — Choose Specialty"
  description="Mateus Alves — Mobile Developer & Site Reliability Engineer. Choose your path to explore the portfolio."
>
  <div class="selector" role="main">
    <!-- Left panel: Mobile Developer -->
    <a href="/mobile" class="selector__panel selector__panel--mobile" data-cursor="enter" data-cursor-theme="mobile" aria-label="Enter Mobile Developer portfolio">
      <div class="selector__panel-content">
        <div class="selector__illustration-wrap" aria-hidden="true">
          <SpecialtyArtwork kind="mobile" />
        </div>
        <div class="selector__text">
          <h2 class="selector__title">Mobile<br />Developer</h2>
          <p class="selector__description">
            Crafting intuitive user experiences for iOS &amp; Android with React Native.
          </p>
          <span class="selector__cta" aria-hidden="true">
            Enter Mobile Portfolio <span class="selector__cta-arrow">→</span>
          </span>
        </div>
      </div>
    </a>

    <!-- Center divider -->
    <div class="selector__divider" aria-hidden="true">
      <span class="selector__divider-text">CHOOSE SPECIALTY</span>
    </div>

    <!-- Right panel: Site Reliability Engineer -->
    <a href="/sre" class="selector__panel selector__panel--sre" data-cursor="enter" data-cursor-theme="sre" aria-label="Enter Site Reliability Engineer portfolio">
      <div class="selector__panel-content">
        <div class="selector__illustration-wrap" aria-hidden="true">
          <SpecialtyArtwork kind="sre" />
        </div>
        <div class="selector__text">
          <h2 class="selector__title">Site Reliability<br />Engineer</h2>
          <p class="selector__description">
            Scaling infrastructure and ensuring the reliability with Kubernetes and Terraform.
          </p>
          <span class="selector__cta" aria-hidden="true">
            Enter SRE Portfolio <span class="selector__cta-icon">⊞</span>
          </span>
        </div>
      </div>
    </a>

    <!-- Bottom social bar -->
    <nav class="selector__social" aria-label="Social links">
      {
        socialLinks.map((link) => (
          <a
            href={link.data.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${link.data.platform} profile`}
            class="selector__social-link"
          >
            {link.data.platform}
          </a>
        ))
      }
      <a
        href={`mailto:${siteData.email}`}
        class="selector__social-link"
        aria-label="Send an email"
      >
        Contact
      </a>
    </nav>
  </div>
</SelectorLayout>

<style>
  /* ===== Selector grid ===== */
  .selector {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100dvh;
  }

  /* ===== Panels ===== */
  .selector__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 3rem 8rem;
    text-decoration: none;
    color: #e2e8f0;
    transition: background-color var(--motion-state), box-shadow var(--motion-state);
    cursor: pointer;
    position: relative;
  }

  .selector__panel--mobile {
    background: radial-gradient(ellipse at 65% 42%, #1d3f6a 0%, #0d1b2a 62%);
  }

  .selector__panel--sre {
    background: radial-gradient(ellipse at 38% 44%, #1a2e52 0%, #111827 62%);
  }

  /* Subtle highlight on the hovered panel */
  .selector__panel--mobile:hover {
    background: radial-gradient(ellipse at 65% 42%, #224876 0%, #0e2033 62%);
  }

  .selector__panel--sre:hover {
    background: radial-gradient(ellipse at 38% 44%, #1e3660 0%, #131e30 62%);
  }

  .selector__panel--mobile :global(.artwork-dock) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--motion-state);
  }

  .selector__panel--mobile:hover :global(.artwork-dock),
  .selector__panel--mobile:focus-visible :global(.artwork-dock) {
    transform: translateY(2px) scale(1.04);
  }

  .selector__panel--sre :global(.artwork-status) { transform-box: fill-box; transform-origin: center; }
  .selector__panel--sre:hover :global(.artwork-status),
  .selector__panel--sre:focus-visible :global(.artwork-status) { animation: status-mark 520ms cubic-bezier(.16,1,.3,1) both; }

  @keyframes status-mark {
    0% { opacity: .45; transform: translateX(-2px); }
    55% { opacity: 1; transform: translateX(1px); }
    100% { opacity: 1; transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .selector__panel--sre:hover :global(.artwork-status),
    .selector__panel--sre:focus-visible :global(.artwork-status) { animation: none; }
  }

  /* Focus visible */
  .selector__panel:hover :global(.selector__illustration-svg),
  .selector__panel:focus-visible :global(.selector__illustration-svg) {
    filter: drop-shadow(0 14px 30px rgba(37, 99, 235, 0.2));
  }

  .selector__panel:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: -4px;
    opacity: 1 !important;
  }

  /* ===== Panel content ===== */
  .selector__panel-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 26rem;
  }

  /* ===== Illustration ===== */
  .selector__illustration-wrap {
    width: 100%;
  }

  .selector__illustration-svg {
    width: 100%;
    max-width: 20rem;
    height: auto;
    display: block;
    border-radius: 0.5rem;
    overflow: visible;
  }

  /* ===== Text ===== */
  .selector__text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .selector__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .selector__description {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    color: #94a3b8;
    line-height: 1.6;
    max-width: 22rem;
  }

  /* ===== CTA button ===== */
  .selector__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.625rem 1.25rem;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 0.375rem;
    transition: background-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    white-space: nowrap;
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.1) inset,
      0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .selector__panel:hover .selector__cta {
    background-color: #1d4ed8;
    transform: translateX(2px);
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.25),
      0 1px 0 rgba(255, 255, 255, 0.15) inset,
      0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .selector__cta-arrow,
  .selector__cta-icon {
    font-style: normal;
  }

  /* ===== Center divider ===== */
  .selector__divider {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .selector__divider::before,
  .selector__divider::after {
    content: '';
    display: block;
    width: 1px;
    height: 5rem;
    background: rgba(226, 232, 240, 0.15);
  }

  .selector__divider-text {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #a9b8cd;
    writing-mode: horizontal-tb;
    white-space: nowrap;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(226, 232, 240, 0.15);
    border-radius: 0.25rem;
  }

  /* ===== Social bar ===== */
  .selector__social {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 2rem;
    align-items: center;
    z-index: 10;
  }

  .selector__social-link {
    font-size: 0.75rem;
    font-weight: 500;
    color: #94a3b8;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 150ms ease;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .selector__social-link:hover {
    color: #e2e8f0;
  }

  /* ===== Mobile responsive ===== */
  @media (max-width: 767px) {
    .selector {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }

    .selector__panel {
      padding: 4rem 2rem 6rem;
      min-height: 50dvh;
    }

    .selector__divider {
      display: none;
    }

    .selector__social {
      position: static;
      transform: none;
      justify-content: center;
      padding: 1.5rem;
      background: #0d1b2a;
      grid-column: 1;
    }

    .selector__title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
  }
</style>
