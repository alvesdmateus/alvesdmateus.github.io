---
interface Props { theme: 'selector' | 'mobile' | 'sre' }
const { theme } = Astro.props;
---
<div class="portfolio-cursor" data-cursor-overlay data-theme={theme} data-base-theme={theme} aria-hidden="true">
  <svg viewBox="0 0 40 40" class="portfolio-cursor__shape" data-cursor-shape="mobile"><rect x="9" y="3" width="22" height="34" rx="7"/><path d="M16 7h8M17 32h6"/></svg>
  <svg viewBox="0 0 40 40" class="portfolio-cursor__shape" data-cursor-shape="sre"><path d="M15 7H8v26h7M25 7h7v26h-7M18 20h4"/></svg>
  <svg class="portfolio-cursor__mark" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 27 27 13M13 13h14v14"/></svg>
</div>
<script>
  import '../../scripts/portfolio-cursor';
</script>
<style is:global>
  .portfolio-cursor { position: fixed; z-index: 9999; left: 0; top: 0; width: 40px; height: 40px; pointer-events: none; opacity: 0; transform: translate3d(-80px,-80px,0); transition: opacity 120ms ease; }
  .portfolio-cursor.is-enabled { opacity: 1; }
  .portfolio-cursor__shape { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--cursor-color, #60a5fa); stroke-width: 1.25; opacity: 0; }
  .portfolio-cursor[data-theme="mobile"] { --cursor-color: #5eead4; }
  .portfolio-cursor[data-theme="sre"] { --cursor-color: #60a5fa; }
  .portfolio-cursor[data-theme="mobile"] [data-cursor-shape="mobile"], .portfolio-cursor[data-theme="sre"] [data-cursor-shape="sre"] { opacity: 1; }
  .portfolio-cursor__mark { position: absolute; inset: 0; width: 40px; height: 40px; color: var(--cursor-color, #93c5fd); opacity: 1; }
  .portfolio-cursor[data-theme="mobile"] .portfolio-cursor__mark, .portfolio-cursor[data-theme="sre"] .portfolio-cursor__mark { opacity: 0; }
  .portfolio-cursor.is-action .portfolio-cursor__shape { opacity: 0 !important; }
  .portfolio-cursor.is-action .portfolio-cursor__mark { opacity: 1; }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) { .portfolio-cursor { display: none; } }
</style>
